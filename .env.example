# Database
# DATABASE_URL is what the RUNNING API uses. It should be the limited role
# `app_runtime` (created by scripts/setup_roles.py): it cannot change the
# schema and can only SELECT/INSERT on item_events.
DATABASE_URL=
# The OWNER role's URL for the same database: used ONLY by scripts/migrate.py
# and scripts/setup_roles.py (migrations and grants). Never by the API.
# OWNER_DATABASE_URL=

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Synthetic data generator (data_engineering/). Must be a SEPARATE database:
# not DATABASE_URL and not TEST_DATABASE_URL.
SYNTHETIC_DATABASE_URL=

# Suggestions file published by `python -m ml.suggest --publish` (optional).
# SUGGESTIONS_PATH=data/serving/suggestions.json

# Where the data came from: real | synthetic. Recorded in every pipeline manifest
# and experiment record (synthetic data verifies the code, not real performance).
# DATA_ORIGIN=

# Optional safety net for the API: the environment this API is meant to use
# (dev | production). The API asks the database for its label at startup and
# refuses to start if it differs. Labels are written by scripts/mark_environment.py.
# EXPECTED_DB_ENVIRONMENT=dev
# Browser origins allowed to call the API (the web front end), comma-separated,
# exact scheme://host[:port] with no trailing slash and never "*".
# Empty = no cross-origin access. For local development with Vite:
# CORS_ORIGINS=http://localhost:5173